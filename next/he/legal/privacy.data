e","איזו קבוצת גיל?","ageLead","ניסיון החינם והספרייה יתחילו בקבוצה הזו.","childTitle","למי הסיפורים?","childLead","מספיק שם פרטי או כינוי. לעולם לא נבקש שם משפחה, תמונה או תאריך לידה.","childName","שם פרטי או כינוי","childNameHint","רק כדי להבדיל בין הפרופילים.","childDefault","פרופיל קריאה","classTitle","הקבוצה בגן","classLead","בפרופיל של קבוצה אין שמות של ילדים.","className","שם הקבוצה","classNameHint","למשל השם של הגן או של הקבוצה.","classDefault","הקבוצה שלי","optional","לא חובה","ניסיון החינם","3 סיפורים ל־3 ימים, עם כל האפשרויות. בלי כרטיס אשראי, והוא אף פעם לא הופך לתשלום.","trialStoriesTitle","הסיפורים בניסיון","trialEndsAt","אם מתחילים עכשיו, הוא מסתיים ב־{date}.","trialAfter","אחר כך הסיפורים האלה ננעלים. הפרופילים וההתקדמות נשמרים. כדי להמשיך אפשר לקנות מסלול; שום דבר לא מתחדש מעצמו.","trialStart","התחלת הניסיון","trialAlreadyUsed","בחשבון הזה כבר נעשה שימוש בניסיון החינם. מסלול פותח את כל הסיפורים של קבוצת גיל.","toFirstStory","פתיחת הסיפור הראשון","החלק הזה מיועד למבוגרים. יש לענות כדי להמשיך.","question","כמה זה {a} × {b}?","answer","תשובה","submit","המשך","wrong","לא בדיוק. הנה שאלה חדשה.","back","חזרה","טוען…","saving","שומר…","offline","אין חיבור לאינטרנט. אי אפשר לשמור דבר עד שהחיבור יחזור.","testMode","מצב ניסיון: חשבונות ורכישות נשמרים רק בדפדפן הזה. שום סכום לא נגבה ולא נשלחות הודעות דוא״ל.","emailTaken","כבר קיים חשבון עם כתובת הדוא״ל הזו.","invalidEmail","יש להזין כתובת דוא״ל, למשל ⁨name@example.com⁩.","weakPassword","יש להשתמש ב־8 תווים לפחות.","wrongCredentials","כתובת הדוא״ל או הסיסמה שגויות. כדאי לבדוק את שתיהן ולנסות שוב.","unconfirmed","כתובת הדוא״ל עדיין לא אושרה. יש לפתוח את הקישור ששלחנו, או לבקש קישור חדש.","rateLimited","יותר מדי ניסיונות. כדאי לחכות כמה דקות ולנסות שוב.","network","אין חיבור. כדאי לבדוק את האינטרנט ולנסות שוב.","unknown","משהו השתבש אצלנו. אפשר לנסות שוב; אם זה חוזר, נשמח לשמוע.","required","זה שדה חובה.","mustAccept","יש לסמן את התיבה כדי להמשיך.","trialUsed","בחשבון הזה כבר נעשה שימוש בניסיון החינם.","noTrialSt