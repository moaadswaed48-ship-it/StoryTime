ctivity",{"_239":240,"_241":242,"_243":244,"_245":246,"_247":248,"_249":250,"_251":252,"_253":254,"_255":256,"_257":258,"_259":260,"_261":262,"_263":264,"_265":266,"_267":268,"_269":270},"collections",{"_119":220,"_221":222,"_223":224,"_225":226,"_227":228,"_229":230,"_231":232,"_233":234,"_235":236,"_237":238},"settings",{"_9":213,"_214":215,"_216":217,"_218":219},"classroom",{"_184":185,"_186":187,"_188":189,"_190":191,"_192":193,"_194":185,"_195":196,"_197":198,"_199":200,"_201":202,"_203":204,"_205":206,"_207":208,"_209":210,"_211":212},"mode","מצב כיתה","modeHint","אותיות גדולות וכפתורים גדולים לקבוצה שמסתכלת על מסך גדול אחד או על מקרן, בלי פרטי החשבון על המסך.","leave","יציאה ממצב כיתה","fullscreen","מסך מלא","exitFullscreen","יציאה ממסך מלא","bar","getReady","מתכוננים","stepOf","שלב {n} מתוך {total}","prevStep","השלב הקודם","nextStep","השלב הבא","teacherNotes","לצוות הגן","nothingOpenTitle","עדיין אין סיפורים פתוחים לכיתה","nothingOpenLead","למבוגרים: ניסיון החינם פותח 3 סיפורים ל־3 ימים, בלי כרטיס אשראי.","trialEndedLead","למבוגרים: ניסיון החינם או המסלול הסתיימו. כדי לפתוח שוב סיפורים, יש לצאת ממצב כיתה ולבחור מסלול.","lockedLead","הסיפור הזה נעול. מבוגר יכול לפתוח אותו עם מסלול, מחוץ למצב כיתה.","קריאה וסרטים","autoFlip","בזמן הקשבה, העמודים מתהפכים לבד","captions","הצגת כתוביות בסרטים","saved","נשמר","כל הסיפורים","films","כל הסרטים","activities","כל הפעילויות","legend","קבוצת גיל","allAges","כל הגילאים","playHere","לצפות כאן","openHere","לפתוח כאן","close","סגירה","toStorybook","לעמוד הספר","empty","עוד אין כאן כלום.","label","פעילות","goal","מה לומדים","need","מה צריך","steps","איך עושים","step","שלב {n}","minutes","כ־{n} דקות","safety","קודם כול בטיחות","forAdult","למבוגרים","inClass","בגן או בכיתה","didIt","עשינו את זה!","done","בוצע. נשמר עבור {name}.","undo","עוד לא עשינו","moving","תמונה זזה","still","תמונה","print","הדפסה","printNote","מדפיס את הפעילות על נייר, עם תמונות סטטיות.","סרט: {title}","סגירת הסרט","notReady","הסרט של הסיפור הזה יגיע בקרו