[{"_1":2,"_3":4},"lang",{"_5":105},"routes/legal",{"_5":6},"data",{"_7":8,"_9":10,"_11":12,"_13":14,"_15":16},"doc","cookies","title","עוגיות ואחסון מקומי","summary","מה האתר שומר בדפדפן ולמה. בלי עוגיות מעקב, בלי פרסומות, ואין על מה ללחוץ „אישור”.","sections",[37,38,39,40,41,42],"chrome",{"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36},"draftTitle","טיוטה: טרם נבדקה על ידי עורך דין","draftBody","העמוד הזה הוא טיוטת עבודה. עורך דין עדיין לא בדק אותו, והוא עשוי להשתנות לפני פתיחת המכירה ב־StoryTime. מקומות מסומנים הם פרטים שעוד לא מילאנו.","placeholder","יושלם בהמשך:","placeholderKey","כך מסומן פרט שעוד לא הושלם","updated","טיוטה מיום {date}","version","גרסת התנאים {version}","languageNote","העמודים האלה קיימים בערבית, בעברית, באנגלית ובדנית. [[איזו גרסה גוברת אם יש הבדל בין השפות: ייקבע עם עורך הדין שלנו]]","contents","בעמוד זה","otherPages","עמודים משפטיים נוספים","backToTop","חזרה לראש העמוד",{"_43":100,"_9":101,"_46":102},{"_43":61,"_9":62,"_46":63},{"_43":57,"_9":58,"_46":59},{"_43":53,"_9":54,"_46":55},{"_43":49,"_9":50,"_46":51},{"_43":44,"_9":45,"_46":47},"id","updates","אם זה ישתנה","body",[48],"אם נרצה אי פעם להוסיף עוגייה שאינה הכרחית או כלי מדידה, נבקש קודם את הסכמתכם עם בחירה ברורה, ונעדכן את העמוד הזה.","control","השליטה בידיים שלכם",[52],"אפשר למחוק את כל מה שהאתר שומר על ידי מחיקת נתוני האתר בהגדרות הדפדפן. אחר כך יהיה צורך להיכנס שוב לחשבון, וההגדרות יחזרו לברירת המחדל.","others","חברות אחרות",[56],"אף חברה אחרת לא מציבה עוגיות דרך StoryTime. בזמן התשלום עוברים לעמוד של חברת הסליקה עצמה, ושם חלים כללי העוגיות שלה. [[חברת הסליקה ומדיניות העוגיות שלה]]","testMode","כשהאתר במצב בדיקה",[60],"לפני פתיחת המכירה האתר יכול לפעול במצב בדיקה, והודעה על המסך מציינת זאת. במצב בדיקה, החשבונות, הפרופילים וההתקדמות נשמרים רק בדפדפן הזה (storytime.local…), לא בשרת.","what","מה נשמר ולמה",[64,65],{"_66":67},"הפריטים האלה נשארים במכשיר. ההגדרות לא נשלחות אלינו.","table",{"_68":69,"_70":71},"head",[97,98,99],"rows",[72,73,74,75,76,77,78],[94,95,96],[92,93,91],[89,90,91],[86,87,88],[84,85,81],[82,83,81],[79,80,81],"הודעות קטנות (storytime.access.dismissed, storytime.justDeleted)","זוכר שסגרתם הודעה, או שחשבון נמחק זה עתה","עד סגירת הלשונית","דוא״ל בתהליך אישור (storytime.pendingEmail)","מציג את הכתובת בעמוד „בדיקת תיבת הדוא״ל”","בדיקה למבוגרים (storytime.gate.passedAt)","זוכר ל־10 דקות שמבוגר ענה על הבדיקה","מיקום בסרט (storytime.film…)","איפה הסרט נעצר, כדי להמשיך משם","עד סוף הסרט, או עד ניקוי האחסון","הפרופיל הפתוח (storytime.activeLearner…)","איזה פרופיל של ילד או ילדה היה פתוח לאחרונה","עד ניקוי האחסון בדפדפן","הגדרות קריאה וסרטים (storytime.prefs…)","גודל טקסט, כתוביות, דפדוף אוטומטי, מדף או רשימה","כניסה לחשבון (sb-…-auth-token)","שומר על החיבור לחשבון במכשיר הזה","עד היציאה מהחשבון","פריט","מה הוא עושה","לכמה זמן","short","בקצרה",[103,104],"StoryTime לא משתמש בעוגיות פרסום, ניתוח או מעקב. הוא שומר כמה פריטים קטנים באחסון של הדפדפן, רק כדי שהאתר יעבוד: כדי להשאיר אתכם מחוברים ולזכור הגדרות. לכן אין חלונית עוגיות לאישור.","[[האם שירות האחסון מציב עוגייה שנדרשת לאבטחה, כשהאתר יעלה לאוויר: יאומת בהשקה]]",{"_1":106,"_107":108},"he","dict",{"_109":110,"_111":112,"_113":114,"_115":116,"_117":118,"_119":120,"_121":122},"common",{"_1110":1111,"_1112":1113,"_1114":1115,"_1116":705,"_1117":1118,"_21":1119,"_936":1120,"_1121":1122,"_1123":1124,"_300":1125,"_1126":1127},"actions",{"_1101":1102,"_1103":893,"_896":897,"_1104":1105,"_1106":1107,"_233":234,"_280":1108,"_282":283,"_371":1109,"_822":823},"pages",{"_1057":1058,"_472":1059,"_1060":1061,"_1062":1063,"_1064":1065,"_1066":1067,"_1068":1069,"_748":1070,"_123":1071,"_125":1072},"account",{"_686":687,"_688":689,"_690":691,"_692":693,"_694":695,"_180":696},"commerce",{"_466":467,"_468":469,"_470":471,"_472":473,"_474":475,"_476":477,"_478":479},"stories",{"_167":168,"_21":169,"_170":171,"_172":173,"_174":175,"_176":177,"_178":179,"_180":181,"_182":183},"support",{"_123":124,"_125":126},"help",{"_127":153,"_154":152,"_155":156,"_157":158,"_15