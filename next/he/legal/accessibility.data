[{"_1":2,"_3":4},"lang",{"_5":89},"routes/legal",{"_5":6},"data",{"_7":8,"_9":10,"_11":12,"_13":14,"_15":16},"doc","accessibility","title","הצהרת נגישות","summary","איך אנחנו הופכים את StoryTime לנוח לכולם, מה עוד חסר, ואיך מדווחים לנו על בעיה.","sections",[37,38,39,40,41],"chrome",{"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36},"draftTitle","טיוטה: טרם נבדקה על ידי עורך דין","draftBody","העמוד הזה הוא טיוטת עבודה. עורך דין עדיין לא בדק אותו, והוא עשוי להשתנות לפני פתיחת המכירה ב־StoryTime. מקומות מסומנים הם פרטים שעוד לא מילאנו.","placeholder","יושלם בהמשך:","placeholderKey","כך מסומן פרט שעוד לא הושלם","updated","טיוטה מיום {date}","version","גרסת התנאים {version}","languageNote","העמודים האלה קיימים בערבית, בעברית, באנגלית ובדנית. [[איזו גרסה גוברת אם יש הבדל בין השפות: ייקבע עם עורך הדין שלנו]]","contents","בעמוד זה","otherPages","עמודים משפטיים נוספים","backToTop","חזרה לראש העמוד",{"_42":85,"_9":86,"_45":87},{"_42":72,"_9":73,"_45":74},{"_42":60,"_9":61,"_45":62},{"_42":48,"_9":49,"_45":50},{"_42":43,"_9":44,"_45":46},"id","date","תאריך ההצהרה","body",[47],"ההצהרה נכתבה ב־25 בנובמבר 2026. [[תאריך בדיקת הנגישות המלאה האחרונה]]","contact","דיווח על בעיה",[51,52,53],"אם משהו קשה לשימוש, או שנדרשת התאמה, נשמח לשמוע:",{"_54":55},"[[תוך כמה זמן נשיב: ייקבע]]","list",[56,57,58,59],"רכז או רכזת נגישות: [[שם]]","דוא״ל: [[כתובת דוא״ל]]","טלפון: [[מספר טלפון, אם יש]]","דואר: [[כתובת למשלוח דואר בישראל]]","gaps","מה עוד חסר",[63,64],"חשוב לנו לומר בגלוי מה עוד חסר:",{"_54":65},[66,67,68,69,70,71],"האתר עדיין לא נבדק ב־Safari באייפון ובאייפד.","עדיין אין קולות מוקלטים; הקריאה המלווה משתמשת בהקלטות ניסיון.","עדיין לא נעשתה בדיקה מלאה מול התקן. היא תיעשה לפני פתיחת המכירה.","בערבית ובעברית, פס הזמן של הסרט עדיין רץ משמאל לימין.","הצבעים והגופנים הסופיים של האתר עדיין בעיצוב; הניגודיות תיבדק שוב כשייקבעו.","עמוד התשלום שייך לחברת הסליקה, שעדיין לא נבחרה.","done","מה כבר בנינו",[75],{"_54":76},[77,78,79,80,81,82,83,84],"קודם כול לטלפון: כל עמוד עובד במסך קטן, עם כפתורים וקישורים גדולים.","הכפתורים והקישורים הם רגילים ופועלים במקלדת, והפריט שעליו עומדים מסומן במסגרת ברורה.","שום דבר לא מוסתר מאחורי ריחוף עם העכבר.","מילות הספרים הן טקסט אמיתי, כך שקוראי מסך יכולים להקריא אותן, ובספר יש אפשרות להגדיל את הטקסט.","לסרטים יש כתוביות בארבע שפות, שמופעלות מההתחלה.","אם המכשיר מבקש פחות תנועה, או לא יכול להציג תלת־ממד, הספר מוצג כספר שטוח בלי הנפשת דפדוף.","העמודים בערבית ובעברית נכתבים מימין לשמאל.","המסכים לילדים קטנים עובדים בעזרת תמונות, לא מילים.","commitment","המטרה שלנו",[88],"אנחנו רוצים שכל ילד, כל ילדה וכל מבוגר יוכלו להשתמש ב־StoryTime. האתר נבנה לפי הנחיות הנגישות לתכני אינטרנט (WCAG) 2.1 ברמה AA, שעליהן מבוסס התקן הישראלי ת״י 5568. [[גרסת ת״י 5568 שחלה: תאומת]]",{"_1":90,"_91":92},"he","dict",{"_93":94,"_95":96,"_97":98,"_99":100,"_101":102,"_103":104},"common",{"_1000":1001,"_1002":1003,"_1004":1005,"_1006":614,"_1007":1008,"_21":1009,"_832":1010,"_209":1011,"_1012":1013},"actions",{"_991":992,"_993":788,"_791":792,"_994":995,"_996":997,"_140":141,"_186":998,"_188":189,"_280":999,"_715":716},"pages",{"_953":954,"_382":955,"_956":957,"_958":959,"_960":961,"_962":963,"_964":965,"_657":966},"account",{"_595":596,"_597":598,"_599":600,"_601":602,"_603":604,"_118":605},"commerce",{"_376":377,"_378":379,"_380":381,"_382":383,"_384":385,"_386":387,"_388":389},"stories",{"_105":106,"_21":107,"_108":109,"_110":111,"_112":113,"_114":115,"_116":117,"_118":119},"library",{"_327":328,"_329":330,"_331":332,"_333":334,"_335":133,"_336":337,"_338":339,"_340":341,"_342":343,"_344":345,"_346":347,"_348":349,"_350":351,"_352":353,"_354":355,"_356":357,"_358":359,"_360":361,"_362":363,"_364":365,"_366":367,"_368":369,"_370":371,"_372":373,"_374":375},{"_323":324,"_325":326},"doors",{"_132":279,"_280":281,"_282":283,"_249":250,"_284":285,"_286":287,"_288":289,"_290":291,"_292":293,"_277":294,"_295":296,"_297":298,"_299":300,"_301":302,"_303":304,"_305":306,"_307":308,"_309":310,"_311":312,"_313":314,"_315":31