[{"_1":2,"_3":4},"lang",{"_5":187},"routes/landing",{"_5":6},"data",{"_7":8},"landing",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24},"hero",{"_25":182,"_59":183,"_184":185,"_186":64},"inside",{"_25":152,"_59":153,"_154":155,"_156":145,"_157":158,"_159":160,"_161":162,"_163":164,"_165":166,"_167":168,"_169":170,"_171":172},"values",{"_25":127,"_59":128,"_129":130,"_131":132,"_133":134,"_135":136,"_137":138},"evidence",{"_25":88,"_89":90,"_91":92,"_93":94,"_95":96,"_97":98,"_99":100,"_101":102},"steps",{"_25":74,"_75":76,"_77":78,"_79":80},"ages",{"_25":65,"_66":67,"_68":69,"_70":71,"_72":73},"plans",{"_25":58,"_59":60,"_61":62,"_63":64},"faq",{"_25":26,"_27":28},"title","أسئلة وأجوبة","items",[29,30,31,32,33,34,35,36,37],{"_38":56,"_40":57},{"_38":54,"_40":55},{"_38":52,"_40":53},{"_38":50,"_40":51},{"_38":48,"_40":49},{"_38":46,"_40":47},{"_38":44,"_40":45},{"_38":42,"_40":43},{"_38":39,"_40":41},"q","هل يوجد صوت مسجَّل؟","a","ليس بعد. سيسجّل راوٍ كلّ حكاية بكلّ لغة، بتسجيل منفصل للكتاب وآخر للفيلم. يصل الصوت قبل بدء بيع الباقات، وحتى ذلك الحين يقرأ الكبار الكتب بأصواتهم.","على أيّ أجهزة يعمل؟","على الهواتف والأجهزة اللوحية والحواسيب، في متصفّح إنترنت حديث. لا حاجة إلى تثبيت تطبيق.","هل يناسب الموقع رياض الأطفال؟","نعم. عند التسجيل يُختار «طاقم روضة أطفال»، فيصبح الملفّ ملفّ الصفّ. ولكلّ نشاط نسخة تناسب مجموعة من الأطفال.","ما المعلومات المحفوظة عن الطفل؟","الحسابات للكبار. ملفّ الطفل فيه اسم أوّل أو لقب، والفئة العمرية فقط. وملفّ طاقم الروضة اسم صفّ، دون أسماء أطفال. لا نطلب رقم هاتف أبدًا، ولا توجد إعلانات.","كيف يُلغى الشراء؟","تنتهي الباقة في تاريخ انتهائها، ولا يتجدّد شيء. وخلال 14 يومًا من الشراء يمكن إلغاؤه من الإعدادات، أو من صفحة «إلغاء عملية شراء»، أو بالبريد الإلكتروني أو البريد العادي. يُردّ المبلغ خلال 14 يومًا، وقد تُخصم رسوم لا تزيد على 5% من السعر أو 100 شيكل، أيّهما أقل.","ماذا تشمل التجربة المجانية؟","3 حكايات من الفئة العمرية المختارة، لمدة 3 أيام، وكلّ أجزائها مفتوحة. لا حاجة إلى بطاقة دفع، ولا تتحوّل التجربة إلى دفعة أبدًا.","ما اللغات المتوفّرة؟","العربية والعبرية والإنجليزية والدنماركية، للموقع وللحكايات وللنصوص المرافقة للأفلام. تُضبط لغة الموقع ولغة الحكايات كلّ واحدة على حدة، فيمكن أن يسمع الطفل حكاية بلغة، بينما يستخدم الكبار الموقع بلغة أخرى.","كم من الوقت أمام الشاشة؟","النشاط يجري بعيدًا عن الشاشة، والكتاب مصنوع لقراءة مشتركة. الأفلام قصيرة وتتوقّف عند نهايتها، ولا يبدأ أيّ شيء بالعمل وحده. وتنصح منظمة الصحة العالمية بألّا يزيد وقت الشاشة على ساعة واحدة في اليوم للأطفال من سنتين إلى 4 سنوات، والأقلّ أفضل.","أيّ فئة عمرية تناسب الطفل؟","الاختيار بحسب العمر: 2–3 أو 4–5 أو 6–8. يبقى الأطفال في الثالثة ضمن الفئة الأولى حتى عيد ميلادهم الرابع. ويمكن أن يضمّ الحساب الواحد باقتين لفئتين عمريتين، للعائلات التي فيها أطفال في أعمار مختلفة.","الباقات","lead","باقة لكلّ فئة عمرية، لشهر أو 3 أشهر أو 12 شهرًا. في كلّ باقة كلّ الميزات.","noRenew","تُدفع الباقة مرة واحدة، ولا تتجدّد من تلقاء نفسها أبدًا.","cta","عرض الباقات","ثلاث فئات عمرية","2-3","كتب قصيرة فيها كلمات تتكرّر ليردّدها الصغار، ولعب باليدين: عدّ حجارة في أكواب، وحمل وسادة إلى أحد أفراد العائلة.","4-5","حكايات فيها مشكلة وشعور، ونشاطات للتدرّب على الإصغاء وتبادل الأدوار.","6-8","حكايات أطول فيها اختيارات حقيقية، ونشاطات مثل البولينغ بعشر أنابيب من الكرتون وجمع النقاط.","planned","من المخطّط أن تضمّ كلّ فئة 15 حكاية. الحكايات الأولى قيد الإعداد الآن.","كيف نبدأ؟","one",{"_25":86,"_82":87},"two",{"_25":84,"_82":85},"three",{"_25":81,"_82":83},"اختيار باقة","text","باقة لشهر أو 3 أشهر أو 12 شهرًا تفتح كلّ حكايات الفئة العمرية، وتنتهي في تاريخها المحدَّد.","تجربة 3 حكايات لمدة 3 أيام","كلّ أجزاء الحكاية مفتوحة، ودون بطاقة دفع.","اختيار الفئة العمرية","إنشاء حساب مجاني للعائلة أو لطاقم روضة الأطفال، واختيار 2–3 أو 4–5 أو 6–8.","لماذا تهمّ حكايات كهذه؟","chart",{"_25":110,"_111":112,"_113":114,"_115":116,"_117":118,"_119":120,"_121":122,"_123":124,"_125":126},"researchTitle","ماذا تقول الأبحاث المنشورة","who",{"_82":108,"_104":109},"durlak",{"_82":106,"_104":107},"jones",{"_82":103,"_104":105},"scope","تناولت هذه الأبحاث برامج مدرسية وأطفالًا جرت متابعتهم سنوات طويلة، ولم تتناول StoryTime.","ownStudy","أجرى مؤسّسو الموقع دراستهم الخاصة مع الأطفال، وستُنشر هنا حين تكتمل.","الأطفال الذين وصفهم طاقم الروضة بأنّهم أكثر تعاونًا ومساعدة للآخرين كانوا أفضل حالًا في التعليم والعمل بعد 13 إلى 19 عامًا. هذه علاقة رُصدت مع مرور الوقت، وليست دليلًا على السبب.","source","جونز وغرينبرغ وكراولي، 2015، المجلة الأمريكية للصحة العامة","وجدت مراجعة شملت 213 برنامجًا مدرسيًا لتعليم المهارات الاجتماعية والعاطفية أنّ نتائج الأطفال الدراسية، حيث قيست، ارتفعت نحو 11 درجة مئينية.","دورلاك وزملاؤه، 2011، مجلة Child Development","تشجّع منظمة الصحة العالمية على القراءة ورواية الحكايات مع أحد الكبار في الأوقات التي يجلس فيها الأطفال دون الخامسة.","منظمة الصحة العالمية، 2019","رسم بياني توضيحي: السلوك الإيجابي مع الوقت","label","رسم توضيحي بأرقام افتراضية. ليس نتائج دراسة.","xAxis","الوقت","yAxis","السلوك الإيجابي","xStart","البداية","xEnd","لاحقًا","yLow","أقلّ","yHigh","أكثر","alt","رسم توضيحي بأرقام افتراضية، لا يعرض نتائج أيّ دراسة: خطّ يرتفع بهدوء من البداية إلى ما بعدها.","ماذا تعلّم الحكايات؟","تحمل كلّ حكاية درسًا واحدًا، يظهر فيما تفعله شخصياتها. أمثلة من حكايات كُتبت وأخرى تُكتب الآن:","elders",{"_139":150,"_141":148,"_82":151},"classmates",{"_139":147,"_141":148,"_82":149},"mother",{"_139":144,"_141":145,"_82":146},"numbers",{"_139":140,"_141":142,"_82":143},"adultNote","يرافق كلّ نشاط شرح للكبار يوضّح الفكرة التي وراءه، ونسخة تناسب مجموعة من الأطفال.","value","الأعداد","group","عمر 6–8","عشر رمّانات وسلّتان. مهما وزّعتها صوفيا وليام بين الخبّاز والطبيبة، يبقى المجموع عشرًا.","البرّ بالأمّ","عمر 2–3","ذراعا ماما مشغولتان، ومفاتيحها تقع. تلتقطها لينا وتناولها لها. وفي البيت، ماما هي التي تقول: شكرًا.","احترام رفاق الصفّ","عمر 4–5","صوت داليا خافت، والغرفة صاخبة. يضع أحد رفاقها إصبعه على شفتيه، ثم آخر، حتى تهدأ الحلقة كلّها ويُسمَع صوت صدفتها.","احترام كبار السنّ","في حافلة يوم مطر، يترك أمين مقعده عند النافذة لامرأة مسنّة تحمل كيسين ثقيلين. فترسم أمواجًا صغيرة بجانب شمسه، وتحدّثه عن البحر الذي كبرت عنده.","ماذا في كلّ حكاية؟","حكاية واحدة من رفّ عمر 2–3، بأجزائها الأربعة.","storyTitle","على مَهل، على مَهل، مَعًا","storyGroup","storyLine","يركض سامي صاعدًا التلّة نحو الزهور الحمراء، ويبقى جدّه بعيدًا في الخلف.","excerptLabel","صفحة من الكتاب","excerpt","يَركُض سامي إلى جَدّه، ويُمسِك يَدَه. على مَهل، على مَهل، مَعًا.","read",{"_173":180,"_82":181},"listen",{"_173":178,"_82":179},"watch",{"_173":176,"_82":177},"do",{"_173":174,"_82":175},"status","قيد الإعداد الآن: كُتبت الحكايات الأولى باللغات الأربع، وما زالت رسومها وأفلامها وتسجيلات الصوت قيد الإنتاج.","name","نشاط","«إطار النَظَر»: نزع وسط صحن ورقي، ثم المشي على مهل في الخارج يدًا بيد، وتسمية ما يظهر داخل الإطار.","مشاهدة","فيلم قصير للحكاية نفسها: ركض سامي وخطوات جدّه، حتى يمشيا بخطو واحد.","استماع","راوٍ يقرأ كلّ صفحة بصوت مسموع، وحين تنتهي القراءة يمكن أن تُقلَب الصفحة وحدها.","قراءة","الكتاب المصوَّر: الكلمات بجانب الرسوم، والصفحات تُقلَب كأنّها من ورق.","حكايات نقرؤها ونشاهدها ونعيشها معًا","حكايات للأطفال من عمر سنتين إلى 8 سنوات تعلّم الاحترام واللطف، ولكلّ حكاية كتاب مصوَّر وفيلم قصير ونشاط مشترك.","primary","بدء التجربة المجانية","secondary",{"_1":188,"_189":190},"ar","dict",{"_191":192,"_193":194,"_195":196,"_197":198,"_199":200,"_201":202},"common",{"_1075":1076,"_1077":1078,"_1079":1080,"_1081":692,"_1082":1083,"_205":1084,"_911":1085,"_306":872,"_1086":1087},"actions",{"_1068":1069,"_1070":430,"_870":871,"_1071":1072,"_1073":1074,"_239":240,"_284":285,"_286":287,"_163":180,"_792":793},"pages",{"_7":1031,"_21":1032,"_1033":1034,"_1035":1036,"_1037":1038,"_1039":1040,"_1041":1042,"_734":1043},"account",{"_673":674,"_675":676,"_677":678,"_679":680,"_681":682,"_217":683},"commerce",{"_465":466,"_467":468,"_469":470,"_21":471,"_472":473,"_474":475,"_476":477},"stories",{"_203":204,"_205":206,"_207":208,"_209":210,"_211":212,"_213":214,"_215":216,"_217":218},"library",{"_416":417,"_418":419,"_420":421,"_422":423,"_424":232,"_425":426,"_427":428,"_429":430,"_431":432,"_433":434,"_435":436,"_437":438,"_439":440,