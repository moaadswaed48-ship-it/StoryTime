[{"_1":2,"_3":4},"lang",{"_5":189},"routes/landing",{"_5":6},"data",{"_7":8},"landing",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24},"hero",{"_25":182,"_59":183,"_184":185,"_186":187,"_188":64},"inside",{"_25":152,"_59":153,"_154":155,"_156":145,"_157":158,"_159":160,"_161":162,"_163":164,"_165":166,"_167":168,"_169":170,"_171":172},"values",{"_25":127,"_59":128,"_129":130,"_131":132,"_133":134,"_135":136,"_137":138},"evidence",{"_25":88,"_89":90,"_91":92,"_93":94,"_95":96,"_97":98,"_99":100,"_101":102},"steps",{"_25":74,"_75":76,"_77":78,"_79":80},"ages",{"_25":65,"_66":67,"_68":69,"_70":71,"_72":73},"plans",{"_25":58,"_59":60,"_61":62,"_63":64},"faq",{"_25":26,"_27":28},"title","أسئلة وأجوبة","items",[29,30,31,32,33,34,35,36,37],{"_38":56,"_40":57},{"_38":54,"_40":55},{"_38":52,"_40":53},{"_38":50,"_40":51},{"_38":48,"_40":49},{"_38":46,"_40":47},{"_38":44,"_40":45},{"_38":42,"_40":43},{"_38":39,"_40":41},"q","هل يوجد صوت مسجَّل؟","a","ليس بعد. سيسجّل راوٍ كلّ حكاية بكلّ لغة، بتسجيل منفصل للكتاب وآخر للفيلم. يصل الصوت قبل بدء بيع الباقات، وحتى ذلك الحين يقرأ الكبار الكتب بأصواتهم.","على أيّ أجهزة يعمل؟","على الهواتف والأجهزة اللوحية والحواسيب، في متصفّح إنترنت حديث. لا حاجة إلى تثبيت تطبيق.","هل يناسب الموقع رياض الأطفال؟","نعم. عند التسجيل يُختار «طاقم روضة أطفال»، فيصبح الملفّ ملفّ الصفّ. ولكلّ نشاط نسخة تناسب مجموعة من الأطفال.","ما المعلومات المحفوظة عن الطفل؟","الحسابات للكبار. ملفّ الطفل فيه اسم أوّل أو لقب، والفئة العمرية فقط. وملفّ طاقم الروضة اسم صفّ، دون أسماء أطفال. لا نطلب رقم هاتف أبدًا، ولا توجد إعلانات.","كيف يُلغى الشراء؟","تنتهي الباقة في تاريخ انتهائها، ولا يتجدّد شيء. وخلال 14 يومًا من الشراء يمكن إلغاؤه من الإعدادات، أو من صفحة «إلغاء عملية شراء»، أو بالبريد الإلكتروني أو البريد العادي. يُردّ المبلغ خلال 14 يومًا، وقد تُخصم رسوم لا تزيد على 5% من السعر أو 100 شيكل، أيّهما أقل.","ماذا تشمل التجربة المجانية؟","3 حكايات من الفئة العمرية المختارة، لمدة 3 أيام، مفتوحة بالكامل. لا حاجة إلى بطاقة دفع، ولا تتحوّل التجربة إلى دفعة أبدًا.","ما اللغات المتوفّرة؟","العربية والعبرية والإنجليزية والدنماركية، للموقع وللحكايات، وللنصوص المرافقة للأفلام حين تجهز. تُضبط لغة الموقع ولغة الحكايات كلّ واحدة على حدة، فيمكن أن تكون حكايات الطفل بلغة، بينما يستخدم الكبار الموقع بلغة أخرى.","كم من الوقت أمام الشاشة؟","النشاط يجري بعيدًا عن الشاشة، والكتاب مصنوع لقراءة مشتركة. وحين تجهز الأفلام ستكون قصيرة وتتوقّف عند نهايتها، ولن يبدأ أيّ شيء بالعمل وحده. وتنصح منظمة الصحة العالمية بألّا يزيد وقت الشاشة على ساعة واحدة في اليوم للأطفال من سنتين إلى 4 سنوات، والأقلّ أفضل.","أيّ فئة عمرية تناسب الطفل؟","الاختيار بحسب العمر: 2–3 أو 4–5 أو 6–8. يبقى الأطفال في الثالثة ضمن الفئة الأولى حتى عيد ميلادهم الرابع. ويمكن أن يضمّ الحساب الواحد باقتين لفئتين عمريتين، للعائلات التي فيها أطفال في أعمار مختلفة.","الباقات","lead","باقة لكلّ فئة عمرية، لشهر أو 3 أشهر أو 12 شهرًا. في كلّ باقة كلّ الميزات.","noRenew","تُدفع الباقة مرة واحدة، ولا تتجدّد من تلقاء نفسها أبدًا.","cta","عرض الباقات","ثلاث فئات عمرية","2-3","كتب قصيرة فيها كلمات تتكرّر ليردّدها الصغار، ولعب باليدين: عدّ حجارة في أكواب، وحمل وسادة إلى أحد أفراد العائلة.","4-5","حكايات فيها مشكلة وشعور، ونشاطات للتدرّب على الإصغاء وتبادل الأدوار.","6-8","حكايات أطول فيها اختيارات حقيقية، ونشاطات مثل البولينغ بعشر أنابيب من الكرتون وجمع النقاط.","planned","من المخطّط أن تضمّ كلّ فئة 15 حكاية. الحكايات الأولى قيد الإعداد الآن.","كيف نبدأ؟","one",{"_25":86,"_82":87},"two",{"_25":84,"_82":85},"three",{"_25":81,"_82":83},"اختيار باقة","text","باقة لشهر أو 3 أشهر أو 12 شهرًا تفتح كلّ حكايات الفئة العمرية، وتنتهي في تاريخها المحدَّد.","تجربة 3 حكايات لمدة 3 أيام","كلّ حكاية مفتوحة بالكامل، ودون بطاقة دفع.","اختيار الفئة العمرية","إنشاء حساب مجاني للعائلة أو لطاقم روضة الأطفال، واختيار 2–3 أو 4–5 أو 6–8.","لماذا تهمّ حكايات كهذه؟","chart",{"_25":110,"_111":112,"_113":114,"_115":116,"_117":118,"_119":120,"_121":122,"_123":124,"_125":126},"researchTitle","ماذا تقول الأبحاث المنشورة","who",{"_82":108,"_104":109},"durlak",{"_82":106,"_104":107},"jones",{"_82":103,"_104":105},"scope","تناولت هذه الأبحاث برامج مدرسية وأطفالًا جرت متابعتهم سنوات طويلة، ولم تتناول StoryTime.","ownStudy","أجرى مؤسّسو الموقع دراستهم الخاصة مع الأطفال، وستُنشر هنا حين تكتمل.","الأطفال الذين وصفهم طاقم الروضة بأنّهم أكثر تعاونًا ومساعدة للآخرين كانوا أفضل حالًا في التعليم والعمل بعد 13 إلى 19 عامًا. هذه علاقة رُصدت مع مرور الوقت، وليست دليلًا على السبب.","source","جونز وغرينبرغ وكراولي، 2015، المجلة الأمريكية للصحة العامة","وجدت مراجعة شملت 213 برنامجًا مدرسيًا لتعليم المهارات الاجتماعية والعاطفية أنّ نتائج الأطفال الدراسية، حيث قيست، ارتفعت نحو 11 درجة مئينية.","دورلاك وزملاؤه، 2011، مجلة Child Development","تشجّع منظمة الصحة العالمية على القراءة ورواية الحكايات مع أحد الكبار في الأوقات التي يجلس فيها الأطفال دون الخامسة.","منظمة الصحة العالمية، 2019","رسم بياني توضيحي: السلوك الإيجابي مع الوقت","label","رسم توضيحي بأرقام افتراضية. ليس نتائج دراسة.","xAxis","الوقت","yAxis","السلوك الإيجابي","xStart","البداية","xEnd","لاحقًا","yLow","أقلّ","yHigh","أكثر","alt","رسم توضيحي بأرقام افتراضية، لا يعرض نتائج أيّ دراسة: خطّ يرتفع بهدوء من البداية إلى ما بعدها.","ماذا تعلّم الحكايات؟","تحمل كلّ حكاية درسًا واحدًا، يظهر فيما تفعله شخصياتها. أمثلة من حكايات كُتبت وأخرى تُكتب الآن:","elders",{"_139":150,"_141":148,"_82":151},"classmates",{"_139":147,"_141":148,"_82":149},"mother",{"_139":144,"_141":145,"_82":146},"numbers",{"_139":140,"_141":142,"_82":143},"adultNote","يرافق كلّ نشاط شرح للكبار يوضّح الفكرة التي وراءه، ونسخة تناسب مجموعة من الأطفال.","value","الأعداد","group","عمر 6–8","عشر رمّانات وسلّتان. مهما وزّعتها صوفيا وليام بين الخبّاز والطبيبة، يبقى المجموع عشرًا.","البرّ بالأمّ","عمر 2–3","ذراعا ماما مشغولتان، ومفاتيحها تقع. تلتقطها لينا وتناولها لها. وفي البيت، ماما هي التي تقول: شكرًا.","احترام رفاق الصفّ","عمر 4–5","صوت داليا خافت، والغرفة صاخبة. يضع أحد رفاقها إصبعه على شفتيه، ثم آخر، حتى تهدأ الحلقة كلّها ويُسمَع صوت صدفتها.","احترام كبار السنّ","في حافلة يوم مطر، يترك أمين مقعده عند النافذة لامرأة مسنّة تحمل كيسين ثقيلين. فترسم أمواجًا صغيرة بجانب شمسه، وتحدّثه عن البحر الذي كبرت عنده.","ماذا في كلّ حكاية؟","حكاية واحدة من رفّ عمر 2–3، بأجزائها الأربعة.","storyTitle","على مَهل، على مَهل، مَعًا","storyGroup","storyLine","يركض سامي صاعدًا التلّة نحو الزهور الحمراء، ويبقى جدّه بعيدًا في الخلف.","excerptLabel","صفحة من الكتاب","excerpt","يَركُض سامي إلى جَدّه، ويُمسِك يَدَه. على مَهل، على مَهل، مَعًا.","read",{"_173":180,"_82":181},"listen",{"_173":178,"_82":179},"watch",{"_173":176,"_82":177},"do",{"_173":174,"_82":175},"status","قيد الإعداد الآن: كُتبت الحكايات الأولى باللغات الأربع، وما زالت رسومها وأفلامها وتسجيلات الصوت قيد الإنتاج.","name","نشاط","«إطار النَظَر»: نزع وسط صحن ورقي، ثم المشي على مهل في الخارج يدًا بيد، وتسمية ما يظهر داخل الإطار.","مشاهدة","فيلم قصير للحكاية نفسها، قيد الإعداد الآن: ركض سامي وخطوات جدّه، حتى يمشيا بخطو واحد.","استماع","سيقرأ راوٍ كلّ صفحة بصوت مسموع، ثم يمكن أن تُقلَب الصفحة وحدها. لم يُسجَّل الصوت بعد.","قراءة","الكتاب، بصفحات تُقلَب كأنّها من ورق. فيه اليوم الكلمات، أمّا الرسوم التي تجاورها فتُرسَم الآن.","حكايات نقرؤها ونشاهدها ونعيشها معًا","حكايات للأطفال من عمر سنتين إلى 8 سنوات تعلّم الاحترام واللطف، وسيكون لكلّ حكاية كتاب مصوَّر وفيلم قصير ونشاط مشترك.","note","جاهز اليوم: نصّ كلّ حكاية ونشاطها باللغات الأربع. وما زال قيد الإعداد: الرسوم والأفلام وصوت الراوي.","primary","بدء التجربة المجانية","secondary",{"_1":190,"_191":192},"ar","dict",{"_193":194,"_195":196,"_197":198,"_199":200,"_201":202,"_203":204,"_205":206},"common",{"_1174":1175,"_1176":1177,"_1178":1179,"_1180":769,"_1181":1182,"_250":1183,"_1005":1184,"_1185":1186,"_1187":1188,"_379":963,"_1189":1190},"actions",{"_1167":1168,"_1169":502,"_961":962,"_1170":1171,"_1172":1173,"_315":316,"_360":361,"_362":363,"_163":180,"_885":886},"pages",{"_7":1124,"_21":1125,"_1126":1127,"_1128":1129,"_1130":1131,"_1132":1133,"_1134":1135,"_811":1136,"_207":1137,"_209":1138},"account",{"_750":751,"_752":753,"_754":755,"_756":757,"_758":759,"_262":760},"commerce",{"_537":538,"_539":540,"_541":542,"_21":543,"_544":545,"_546":547,"_548"