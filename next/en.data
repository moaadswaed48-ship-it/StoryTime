rom {date}","passUntil","Until {date}","daysLeft","Days left: {n}","passStatus",{"_800":801,"_802":803,"_804":805,"_806":807,"_796":797,"_798":799},"cancelUntil","This purchase can be cancelled until {date}.","cancelPurchase","Cancel this purchase","paymentsTitle","Payment history","noPayments","No payments yet.","orderStatus",{"_790":791,"_792":793,"_794":795,"_796":797,"_798":799},"receiptNote","Receipts are issued by the payment company once it is connected.","newsTitle","News by email","newsCheck","Send me news when new stories arrive","serviceNote","Service emails, such as confirmations, receipts and reminders before a pass ends, are always sent.","passwordTitle","Password","changePassword","Change password","passwordChanged","Password changed.","dataTitle","Your data","download","Download my data","downloadNote","A file with everything we hold about this account.","correctNote","To correct something we hold, write to us.","deleteTitle","Delete account","deleteWarn","This removes the account, every profile and all progress, and signs you out.","deleteKept","Payment records are kept for tax purposes, without your name.","deletePass","An active pass is lost and deleting does not refund it. To cancel a purchase within its 14 days, use “Cancel this purchase” first.","deleteType","To confirm, type the email of this account","deleteMismatch","This is not the email of this account.","deleteSubmit","Delete my account","changeEmail","Change email address","newEmail","New email address","sendEmailLink","Send the confirmation link","emailLinkSent","We sent a link to {email}. The address changes only when the link is opened. It works for 24 hours.","emailChangeNote","Your current address stays until the link is opened. Then we send a notice to your current address.","deletedTitle","Your account is deleted","deletedLead","The account, its profiles and their progress are removed. Payment records are kept for tax purposes, without your name.","signOut","Sign out","pending","Waiting for payment","paid","Paid","failed","Failed","cancelled","Cancelled","refunded","Refunded","queued","Starts later","active","Active","ending_soon","Ending soon","ended","Ended","stepOf","Step {n} of {total}","skip","Skip","Which language should the stories use?","languageLead","Story text, voice and captions follow this choice. You can change it later in Settings.","ageTitle","Which age group?","ageLead","The free trial and the library start with this group.","childTitle","childLead","A first name or a nickname is enough. We never ask for a surname, photo or birthday.","childName","First name or nickname","childNameHint","Only to tell profiles apart.","childDefault","Reader","classTitle","Your class","classLead","A class profile holds no children’s names.","className","Class name","classNameHint","For example the name of your group.","classDefault","My class","optional","Optional","Your free trial","3 stories for 3 days, with every feature. No card, and it never turns into a payment.","trialStoriesTitle","The stories in your trial","trialEndsAt","If you start now, it ends on {date}.","trialAfter","After that, these stories lock. Profiles and progress are kept. To go on, a pass can be bought; nothing renews by itself.","trialStart","Start the trial","trialAlreadyUsed","This account has already used its free trial. Passes open every story of an age group.","toFirstStory","Open the first story","For adults","This part is for grown-ups. Answer to continue.","question","How much is {a} × {b}?","answer","Answer","submit","wrong","Not quite. Here is a new question.","back","Go back","Loading…","saving","Saving…","offline","You are offline. Nothing can be saved until the connection is back.","testMode","Test mode: accounts and purchases are kept only in this browser. Nothing is charged and no email is sent.","emailTaken","An account already uses this email.","invalidEmail","Enter an email address, for example name@example.com.","weakPassword","Use at least 8 characters.","wrongCredentials","The email or the password is not right. Check both and try again.","unconfirmed","This email is not confirmed yet. Open the link we sent, or ask for a new one.","rateLimited","Too many tries. Wait a few minutes, then try again.","network","No connection. Check the internet and try again.","unknown","Something went wrong on our side. Try again; if it keeps happening, contact us.","required","This is needed.","mustAccept","Tick this box to continue.","trialUsed","This account has already used its free trial.","noTrialStories","No trial stories are ready for this age group yet.","profileLimit","An account can hold up to 5 profiles.","roleLocked","This can no longer be changed, because the account already has profiles.","cancelWindowClosed","The 14 days for cancelling this purchase have passed.","passNotActive","This pass is no longer active.","notFound","We could not find this.","This story is locked.","retry","signUpTitle","Create an account","signUpLead","Start the free trial: 3 stories for 3 days, with every feature. No card needed.","Email","password","showPassword","Show password","hidePassword","Hide password","passwordHint","At least 8 characters. A short sentence is easy to remember and hard to guess.","strength",{"_1019":1020,"_1021":1022,"_1023":1024},"roleLegend","Who will use StoryTime?","A parent or family member","roleParentHint","Profiles for your children","Kindergarten staff","roleTeacherHint","A profile for your class, without children’s names","adultsOnly","Accounts are for adults.","adultCheck","I am 18 or older","I agree to the Terms of use and have read the Privacy policy","readTerms","Read the Terms of use","readPrivacy","Read the Privacy policy","marketingCheck","Send me news by email when new stories arrive (optional)","marketingHint","You can stop at any time in Settings.","dataNote","Needed to create the account: email and password. Optional: news by email. We never ask for a phone number.","submitSignUp","Create account","haveAccount","Already have an account?","signInLink","Sign in","checkTitle","Check your email","checkLead","We sent a confirmation link to {email}. Open it to continue. The link works for 24 hours.","checkSpam","Not there after a few minutes? Look in spam or promotions.","checkResend","Send the link again","checkResent","A new link is on its way.","checkWait","You can ask for another link in a minute.","checkWrong","Wrong address? Create the account again with the right one.","confirmWorking","Opening your link…","testOpenEmailChange","Open the link to confirm the new address","emailChangedTitle","Your email address is changed","emailChangedLead","From now on, sign in with {email}. We told your old address about the change.","emailChangedContinue","linkExpiredTitle","This link has expired or was already used","linkExpiredLead","Links from our emails work once and for a limited time. Ask for a new one below.","linkExpiredEmail","Email of your account","linkExpiredSend","Send a new link","signInTitle","submitSignIn","forgot","Forgot password?","noAccount","New to StoryTime?","createLink","sendAgain","Send the confirmation link again","forgotTitle","Reset your password","forgotLead","Enter the email of your account. If an account uses it, we send a link to choose a new password.","forgotSubmit","Send the link","forgotSent","If an account uses {email}, a link is on its way. It works for one hour.","backToSignIn","Back to sign in","resetTitle","Choose a new password","newPassword","New password","resetSubmit","Save the new password","resetDone","Your password is changed.","sessionExpired","Please sign in again. You will return to the same page.","testEmailTitle","Test mode: no email is sent","testEmailLead","Until the email service is connected, the link that would be in the email is shown here.","testOpenConfirm","Open the confirmation link","testOpenReset","Open the password link","weak","Too short","fair","Good enough","strong","Strong",{"_25":1061,"_1038":183},