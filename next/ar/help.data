[{"_1":2,"_3":4},"lang",{"_5":38},"routes/help",{"_5":6},"data",{"_7":8},"faq",[9,10,11,12,13,14,15,16,17],{"_18":36,"_20":37},{"_18":34,"_20":35},{"_18":32,"_20":33},{"_18":30,"_20":31},{"_18":28,"_20":29},{"_18":26,"_20":27},{"_18":24,"_20":25},{"_18":22,"_20":23},{"_18":19,"_20":21},"q","هل يوجد صوت مسجَّل؟","a","ليس بعد. سيسجّل راوٍ كلّ حكاية بكلّ لغة، بتسجيل منفصل للكتاب وآخر للفيلم. يصل الصوت قبل بدء بيع الباقات، وحتى ذلك الحين يقرأ الكبار الكتب بأصواتهم.","على أيّ أجهزة يعمل؟","على الهواتف والأجهزة اللوحية والحواسيب، في متصفّح إنترنت حديث. لا حاجة إلى تثبيت تطبيق.","هل يناسب الموقع رياض الأطفال؟","نعم. عند التسجيل يُختار «طاقم روضة أطفال»، فيصبح الملفّ ملفّ الصفّ. ولكلّ نشاط نسخة تناسب مجموعة من الأطفال.","ما المعلومات المحفوظة عن الطفل؟","الحسابات للكبار. ملفّ الطفل فيه اسم أوّل أو لقب، والفئة العمرية فقط. وملفّ طاقم الروضة اسم صفّ، دون أسماء أطفال. لا نطلب رقم هاتف أبدًا، ولا توجد إعلانات.","كيف يُلغى الشراء؟","تنتهي الباقة في تاريخ انتهائها، ولا يتجدّد شيء. وخلال 14 يومًا من الشراء يمكن إلغاؤه من الإعدادات، أو من صفحة «إلغاء عملية شراء»، أو بالبريد الإلكتروني أو البريد العادي. يُردّ المبلغ خلال 14 يومًا، وقد تُخصم رسوم لا تزيد على 5% من السعر أو 100 شيكل، أيّهما أقل.","ماذا تشمل التجربة المجانية؟","3 حكايات من الفئة العمرية المختارة، لمدة 3 أيام، مفتوحة بالكامل. لا حاجة إلى بطاقة دفع، ولا تتحوّل التجربة إلى دفعة أبدًا.","ما اللغات المتوفّرة؟","العربية والعبرية والإنجليزية والدنماركية، للموقع وللحكايات، وللنصوص المرافقة للأفلام حين تجهز. تُضبط لغة الموقع ولغة الحكايات كلّ واحدة على حدة، فيمكن أن تكون حكايات الطفل بلغة، بينما يستخدم الكبار الموقع بلغة أخرى.","كم من الوقت أمام الشاشة؟","النشاط يجري بعيدًا عن الشاشة، والكتاب مصنوع لقراءة مشتركة. وحين تجهز الأفلام ستكون قصيرة وتتوقّف عند نهايتها، ولن يبدأ أيّ شيء بالعمل وحده. وتنصح منظمة الصحة العالمية بألّا يزيد وقت الشاشة على ساعة واحدة في اليوم للأطفال من سنتين إلى 4 سنوات، والأقلّ أفضل.","أيّ فئة عمرية تناسب الطفل؟","الاختيار بحسب العمر: 2–3 أو 4–5 أو 6–8. يبقى الأطفال في الثالثة ضمن الفئة الأولى حتى عيد ميلادهم الرابع. ويمكن أن يضمّ الحساب الواحد باقتين لفئتين عمريتين، للعائلات التي فيها أطفال في أعمار مختلفة.",{"_1":39,"_40":41},"ar","dict",{"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":55},"common",{"_996":997,"_998":999,"_1000":1001,"_1002":605,"_1003":1004,"_102":1005,"_825":1006,"_208":786,"_1007":1008},"actions",{"_989":990,"_991":339,"_784":785,"_992":993,"_994":995,"_137":138,"_185":186,"_187":188,"_279":280,"_706":707},"pages",{"_944":945,"_380":946,"_947":948,"_949":950,"_951":952,"_953":954,"_955":956,"_648":957,"_56":958,"_58":959},"account",{"_586":587,"_588":589,"_590":591,"_592":593,"_594":595,"_114":596},"commerce",{"_374":375,"_376":377,"_378":379,"_380":381,"_382":383,"_384":385,"_386":387},"stories",{"_100":101,"_102":103,"_104":105,"_106":107,"_108":109,"_110":111,"_112":113,"_114":115},"support",{"_56":57,"_58":59},"help",{"_60":86,"_87":85,"_88":89,"_90":91,"_92":93,"_94":95,"_96":97,"_98":99},"contact",{"_60":61,"_62":63,"_64":65,"_66":67,"_68":69,"_70":71,"_72":73,"_74":75,"_76":77,"_78":79,"_80":81,"_82":83,"_84":85},"lead","سؤال أو فكرة أو مشكلة في الموقع: يمكن كتابتها هنا.","name","الاسم","email","البريد الإلكتروني","emailHint","يُستخدم للردّ على هذه الرسالة فقط.","message","الرسالة","messageHint","حتى 2000 حرف.","tooLong","الرسالة طويلة جدًّا. الحدّ الأقصى 2000 حرف.","send","إرسال الرسالة","sent","شكرًا لكم. حُفظت الرسالة.","sendAnother","كتابة رسالة أخرى","testNote","وضع التجربة: تُحفظ الرسائل في هذا المتصفّح فقط. لا يقرؤها أحد بعد، ولا يُرسَل أيّ بريد إلكتروني.","otherWays","طرق أخرى للتواصل","helpLink","أسئلة وأجوبة","إجابات عن الأسئلة التي يطرحها الأهل وطواقم رياض الأطفال أكثر من غيرها، وطرق التواصل معنا.","faqTitle","contactTitle","هل بقي سؤال؟","contactLead","يمكن الكتابة إلينا عبر نموذج التواصل.","contactLink","فتح نموذج التواصل","emailPlaceholder","عنوان البريد الإلكتروني للدعم: يُضاف قبل بدء البيع.","cancelTitle","إلغاء عملية شراء","cancelLead","خلال 14 يومًا من شراء باقة، يمكن إلغاء الشراء من صفحة «إلغاء عملية شراء»