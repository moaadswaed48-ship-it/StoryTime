PayFail","כישלון תשלום (ניסיון)","testPayCancel","ביטול וחזרה","amount","סכום","signInFirst","כדי לקנות מסלול יש להיכנס לחשבון או ליצור חשבון.","מסלול לכל קבוצת גיל. מסלול פותח את כל הסיפורים של הקבוצה, עם כל מה שבהם.","placeholderBadge","זמני","priceNotSet","המחיר עוד לא נקבע","vatIncluded","המחיר בשקלים, כולל מע״מ","perMonth","לחודש: {price}","total","סך הכול: {price}","paidOnce","תשלום חד־פעמי. לא מתחדש.","choose","בחירה: {length}","allFeatures","בכל מסלול יש את כל האפשרויות. ההבדל היחיד הוא משך הזמן.","factsTitle","לפני הרכישה","factInstant","הגישה נפתחת באתר מיד אחרי התשלום.","factEnds","המסלול מסתיים בתאריך הסיום שלו, ונשלח תזכורת בדוא״ל לפני כן.","factTwoGroups","בחשבון אחד אפשר להחזיק מסלולים לשתי קבוצות גיל.","factQueue","מסלול שנקנה בזמן שמסלול אחר לאותה קבוצה פעיל יתחיל כשהקודם יסתיים.","factCancel","אפשר לבטל תוך 14 יום מהרכישה. ההחזר יינתן תוך 14 יום; ייתכן ניכוי דמי ביטול של 5% מהמחיר או 100 ש״ח לכל היותר, הנמוך מביניהם.","factValidity","המחירים עוד לא נקבעו, ולכן אין הצעה פתוחה. אחרי שייקבעו, יחול המחיר שמוצג ברגע הרכישה.","factValiditySet","חל המחיר שמוצג ברגע הרכישה.","factValidityPartial","עדיין אי אפשר לקנות מסלולים שמסומנים „המחיר עוד לא נקבע”. על השאר חל המחיר שמוצג ברגע הרכישה.","priceSetSome","המחיר עוד לא נקבע לכל קבוצות הגיל","israelOnly","בהשקה, הרכישה פתוחה ללקוחות בישראל. ניסיון החינם זמין בכל מקום.","cancelLink","איך מבטלים רכישה","sellerTitle","המוכר","sellerPlaceholder","שם העסק, מספר הזהות או מספר העסק והכתובת: יתווספו לפני פתיחת המכירה.","trialTitle","עוד לא בטוחים?","trialLead","אפשר לנסות 3 סיפורים ל־3 ימים, חינם ובלי כרטיס אשראי.","trialCta","1","חודש אחד","3","3 חודשים","12","12 חודשים","לילדים בני שנתיים ושלוש","לילדים בני 4 ו־5","לילדים בני 6, 7 ו־8","auth",{"_1007":1008,"_1009":1010,"_213":1011,"_1012":844,"_1013":1014,"_1015":1016,"_1017":1018,"_1019":1020,"_1021":1022,"_764":1023,"_1024":1025,"_766":1026,"_1027":1028,"_1029":1030,"_1031":1032,"_646":1033,"_1034":1035,"_1036":1037,"_1038":1039,"_1040":1041,"_1042":1043,"_1044