[{"_1":2,"_3":4},"lang",{"_5":189},"routes/landing",{"_5":6},"data",{"_7":8},"landing",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24},"hero",{"_25":182,"_59":183,"_184":185,"_186":187,"_188":64},"inside",{"_25":152,"_59":153,"_154":155,"_156":145,"_157":158,"_159":160,"_161":162,"_163":164,"_165":166,"_167":168,"_169":170,"_171":172},"values",{"_25":127,"_59":128,"_129":130,"_131":132,"_133":134,"_135":136,"_137":138},"evidence",{"_25":88,"_89":90,"_91":92,"_93":94,"_95":96,"_97":98,"_99":100,"_101":102},"steps",{"_25":74,"_75":76,"_77":78,"_79":80},"ages",{"_25":65,"_66":67,"_68":69,"_70":71,"_72":73},"plans",{"_25":58,"_59":60,"_61":62,"_63":64},"faq",{"_25":26,"_27":28},"title","שאלות ותשובות","items",[29,30,31,32,33,34,35,36,37],{"_38":56,"_40":57},{"_38":54,"_40":55},{"_38":52,"_40":53},{"_38":50,"_40":51},{"_38":48,"_40":49},{"_38":46,"_40":47},{"_38":44,"_40":45},{"_38":42,"_40":43},{"_38":39,"_40":41},"q","יש הקלטה של קריין?","a","עוד לא. קריין יקליט כל סיפור בכל שפה, בהקלטה נפרדת לספר ולסרט. הקול יגיע לפני שהמסלולים יעלו למכירה; עד אז, המבוגרים קוראים את הספרים בקול.","על אילו מכשירים זה עובד?","בטלפונים, בטאבלטים ובמחשבים, בדפדפן עדכני. אין צורך להתקין אפליקציה.","האם זה מתאים לגנים?","כן. בהרשמה בוחרים ״צוות גן ילדים״, והפרופיל הופך לפרופיל של הקבוצה. לכל פעילות יש גרסה לקבוצת ילדים.","מה שומרים על הילדים?","החשבונות שייכים למבוגרים. בפרופיל של ילד יש רק שם פרטי או כינוי וקבוצת גיל. הפרופיל של צוות גן הוא שם של קבוצה, בלי שמות של ילדים. אנחנו אף פעם לא מבקשים מספר טלפון, ואין פרסומות.","איך מבטלים?","מסלול מסתיים בתאריך הסיום שלו, ושום דבר לא מתחדש. בתוך 14 יום מהרכישה אפשר לבטל אותה בהגדרות, בעמוד ״ביטול רכישה״, או בדוא״ל או בדואר. ההחזר יינתן תוך 14 יום; ייתכן ניכוי דמי ביטול של 5% מהמחיר או 100 ש״ח לכל היותר, הנמוך מביניהם.","מה כולל ניסיון החינם?","3 סיפורים מקבוצת הגיל שנבחרה, ל־3 ימים, פתוחים במלואם. לא צריך כרטיס אשראי, והניסיון אף פעם לא הופך לתשלום.","באילו שפות?","ערבית, עברית, אנגלית ודנית: באתר, בסיפורים, ובכתוביות של הסרטים כשיהיו מוכנים. את שפת האתר ואת שפת הסיפורים קובעים בנפרד, כך שהסיפורים של הילדים יכולים להיות בשפה אחת בזמן שהמבוגרים משתמשים באתר בשפה אחרת.","כמה זמן מסך זה?","הפעילות נעשית הרחק מהמסך, והספר נועד לקריאה משותפת. כשהסרטים יהיו מוכנים, הם יהיו קצרים וייעצרו בסופם, ושום דבר לא יתחיל לפעול מעצמו. ארגון הבריאות העולמי ממליץ על שעת מסך אחת ביום לכל היותר לילדים בגילאי 2 עד 4, ועדיף פחות.","איזו קבוצת גיל מתאימה לילד או לילדה?","בוחרים לפי הגיל: 2–3, 4–5 או 6–8. ילדים בני שלוש נשארים בקבוצה הראשונה עד יום ההולדת הרביעי. בחשבון אחד אפשר להחזיק מסלולים לשתי קבוצות גיל, למשפחות עם ילדים בגילים שונים.","מסלולים","lead","מסלול לכל קבוצת גיל, לחודש, ל־3 חודשים או ל־12 חודשים. בכל מסלול יש את כל האפשרויות.","noRenew","משלמים על מסלול פעם אחת, והוא אף פעם לא מתחדש מעצמו.","cta","למסלולים","שלוש קבוצות גיל","2-3","ספרים קצרים עם מילים שחוזרות ואפשר להצטרף אליהן, ומשחק בידיים: לספור אבנים לתוך כוסות, להביא כרית למישהו בבית.","4-5","סיפורים עם בעיה ועם רגש, ופעילויות שמתרגלות הקשבה ותורות.","6-8","סיפורים ארוכים יותר עם בחירות אמיתיות, ופעילויות כמו באולינג עם עשרה גלילי קרטון וחיבור הנקודות.","planned","בכל קבוצה מתוכננים 15 סיפורים. הראשונים נמצאים עכשיו בהכנה.","איך מתחילים","one",{"_25":86,"_82":87},"two",{"_25":84,"_82":85},"three",{"_25":81,"_82":83},"בוחרים מסלול","text","מסלול לחודש, ל־3 חודשים או ל־12 חודשים פותח את כל הסיפורים של קבוצת הגיל, ומסתיים בתאריך שלו.","מנסים 3 סיפורים ל־3 ימים","כל סיפור פתוח במלואו. בלי כרטיס אשראי.","בוחרים קבוצת גיל","פותחים חשבון חינם למשפחה או לצוות גן ילדים, ובוחרים 2–3, 4–5 או 6–8.","למה סיפורים כאלה חשובים","chart",{"_25":110,"_111":112,"_113":114,"_115":116,"_117":118,"_119":120,"_121":122,"_123":124,"_125":126},"researchTitle","מה אומר המחקר שפורסם","who",{"_82":108,"_104":109},"durlak",{"_82":106,"_104":107},"jones",{"_82":103,"_104":105},"scope","המחקרים האלה בדקו תוכניות בבתי ספר וילדים שנעקבו לאורך שנים. הם לא בדקו את StoryTime.","ownStudy","מייסדי האתר ערכו מחקר משלהם עם ילדים. הוא יפורסם כאן כשיהיה מוכן.","ילדים שצוות הגן תיאר כעוזרים ומשתפים פעולה יותר הצליחו יותר בלימודים ובעבודה 13 עד 19 שנים מאוחר יותר. זה קשר שנצפה לאורך זמן, ולא הוכחה לסיבה.","source","ג׳ונס, גרינברג וקראולי, 2015, כתב העת האמריקאי לבריאות הציבור","סקירה של 213 תוכניות בבתי ספר שמלמדות כישורים חברתיים ורגשיים מצאה שבמקומות שבהם נמדדו ההישגים בלימודים, הם עלו בכ־11 נקודות אחוזון.","דורלק ועמיתיו, 2011, כתב העת Child Development","ארגון הבריאות העולמי ממליץ על קריאה וסיפור סיפורים עם מבוגר בזמן שילדים מתחת לגיל 5 יושבים.","ארגון הבריאות העולמי, 2019","גרף לדוגמה: התנהגות חיובית לאורך זמן","label","איור עם מספרים לדוגמה. אלה אינן תוצאות מחקר.","xAxis","זמן","yAxis","התנהגות חיובית","xStart","התחלה","xEnd","בהמשך","yLow","פחות","yHigh","יותר","alt","איור עם מספרים לדוגמה, שאינו מציג תוצאות של אף מחקר: קו שעולה בהדרגה מההתחלה ועד בהמשך.","מה הסיפורים מלמדים","כל סיפור נושא שיעור אחד, שמתגלה במה שהדמויות עושות. דוגמאות מסיפורים שנכתבו ומסיפורים שנכתבים עכשיו:","elders",{"_139":150,"_141":148,"_82":151},"classmates",{"_139":147,"_141":148,"_82":149},"mother",{"_139":144,"_141":145,"_82":146},"numbers",{"_139":140,"_141":142,"_82":143},"adultNote","לכל פעילות מצורף הסבר למבוגרים על הרעיון שמאחוריה, וגרסה לקבוצת ילדים.","value","מספרים","group","גילאי 6–8","עשרה רימונים, שני סלים. איך שלא יחלקו אותם סופיה וליאם בין האופה לרופאה, תמיד יש עשרה.","כיבוד אם","גילאי 2–3","הידיים של אמא מלאות, והמפתחות שלה נופלים. לינה מרימה אותם ומגישה לה. ובבית, דווקא אמא היא זו שאומרת תודה.","כבוד לחברים בגן","גילאי 4–5","הקול של דליה חלש, והחדר רועש. ילד אחד מניח אצבע על השפתיים, ואחריו עוד אחד, עד שכל המעגל שקט ואפשר לשמוע את הקונכייה שלה.","כבוד למבוגרים","באוטובוס ביום גשום, אמין מפנה את המקום שלו ליד החלון לאישה מבוגרת עם שני סלים כבדים. היא מציירת גלים קטנים ליד השמש שלו ומספרת לו על הים שלידו גדלה.","מה יש בכל סיפור","סיפור אחד מהמדף של גילאי 2–3, על ארבעת חלקיו.","storyTitle","לְאַט, לְאַט, בְּיַחַד","storyGroup","storyLine","סאמי רץ במעלה הגבעה אל הפרחים האדומים, וסבא נשאר הרחק מאחור.","excerptLabel","עמוד מתוך הספר","excerpt","סָאמִי רָץ בַּחֲזָרָה אֶל סַבָּא. הוּא נוֹתֵן לוֹ יָד. לְאַט, לְאַט, בְּיַחַד.","read",{"_173":180,"_82":181},"listen",{"_173":178,"_82":179},"watch",{"_173":176,"_82":177},"do",{"_173":174,"_82":175},"status","בעבודה עכשיו: הסיפורים הראשונים כתובים בארבע השפות. האיורים, הסרטים וההקלטות שלהם עדיין בהפקה.","name","לעשות","״מסגרת ההסתכלות״: לקרוע את האמצע של צלחת נייר, ללכת לאט בחוץ יד ביד, ולומר את שמו של מה שנראה בתוך המסגרת.","לצפות","סרט קצר על אותו סיפור, שנמצא עכשיו בהכנה: הריצה של סאמי והצעדים של סבא, עד שהם הולכים באותו קצב.","להקשיב","כל עמוד יוקרא בקול, ואחר כך הדף יוכל להתהפך מעצמו. הקריינות עוד לא הוקלטה.","לקרוא","הספר, עם דפים שמתהפכים כמו דפי נייר. כבר היום יש בו המילים, והאיורים שלצידן מצוירים עכשיו.","לקרוא, לצפות ולעשות יחד","סיפורים לגילאי 2 עד 8 שמלמדים כבוד וטוב לב. לכל סיפור יהיו ספר מאויר, סרט קצר ופעילות משותפת.","note","מוכן כבר היום: המילים והפעילות של כל סיפור, בארבע השפות. עדיין בהכנה: האיורים, הסרטים וקול הקריינות.","primary","התחלת ניסיון חינם","secondary",{"_1":190,"_191":192},"he","dict",{"_193":194,"_195":196,"_197":198,"_199":200,"_201":202,"_203":204,"_205":206},"common",{"_1177":1178,"_1179":1180,"_1181":1182,"_1183":769,"_1184":1185,"_250":1186,"_1003":1187,"_1188":1189,"_1190":1191,"_380":1192,"_1193":1194},"actions",{"_1168":1169,"_1170":956,"_959":960,"_1171":1172,"_1173":1174,"_315":316,"_361":1175,"_363":364,"_163":1176,"_885":886},"pages",{"_7":1124,"_21":1125,"_1126":1127,"_1128":1129,"_1130":1131,"_1132":1133,"_1134":1135,"_811":1136,"_207":1137,"_209":1138},"account",{"_750":751,"_752":753,"_754":755,"_756":757,"_758":759,"_262":760},"commerce",{"_538":539,"_540":541,"_542":543,"_21":544,"_545":546,"_547":548,"_549":550},"stories",{"_248":249,"_250":251,"_252":253,"_254":255,"_256":257,"_258":259,"_260":261,"_262":263,"_264":265},"support",{"_207":208,"_209":210},"help",{"_59":234,"_235":26,"_236":237,"_238":239,"_240":241,"_242":243,"_244":245,"_246":247},"contact",{"_59":211,"_173":212,"_213":214,"_215":216,"_217":218,"_