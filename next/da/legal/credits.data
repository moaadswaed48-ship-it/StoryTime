[{"_1":2,"_3":4},"lang",{"_5":117},"routes/legal",{"_5":6},"data",{"_7":8,"_9":10,"_11":12,"_13":14,"_15":16},"doc","credits","title","Krediteringer og licenser","summary","Hvem der har skrevet og lavet det, du ser på StoryTime, og de eksterne værktøjer, vi bruger, med deres licenser.","sections",[37,38,39,40,41],"chrome",{"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36},"draftTitle","Udkast: endnu ikke gennemgået af en advokat","draftBody","Denne side er et arbejdsudkast. En advokat har ikke gennemgået den endnu, og den kan ændre sig, før StoryTime åbner for salg. Markerede steder er oplysninger, vi endnu ikke har udfyldt.","placeholder","Udfyldes senere:","placeholderKey","Sådan markeres en oplysning, der endnu mangler","updated","Udkast af {date}","version","Vilkårsversion {version}","languageNote","Disse sider findes på arabisk, hebraisk, engelsk og dansk. [[Hvilken sprogversion der gælder, hvis de afviger: afgøres med vores advokat]]","contents","På denne side","otherPages","Andre juridiske sider","backToTop","Til toppen af siden",{"_42":112,"_9":113,"_45":114},{"_42":107,"_9":108,"_45":109},{"_42":103,"_9":104,"_45":105},{"_42":48,"_9":49,"_45":50},{"_42":43,"_9":44,"_45":46},"id","copyright","Ophavsret","body",[47],"© 2026 [[virksomhedens navn]]. Alle rettigheder forbeholdes til StoryTimes historier, billeder, film og aktiviteter. En historie, der er krediteret sin forfatter, tilhører fortsat forfatteren.","code","Kodebiblioteker",[51,52,53],"StoryTime er bygget med disse åbne biblioteker. Tak til dem, der har lavet dem.",{"_54":55},"Disse biblioteker bruger igen andre biblioteker, hver under sin egen licens. [[Komplet liste over alle biblioteker og licenser: laves før lanceringen]]","table",{"_56":57,"_58":59},"head",[100,101,102],"rows",[60,61,62,63,64,65,66,67,68,69,70,71],[98,99,77],[96,97,77],[93,94,95],[91,92,77],[89,90,77],[87,88,77],[85,86,77],[82,83,84],[80,81,77],[78,79,77],[75,76,77],[72,73,74],"isbot","isbot contributors","Unlicense (fri for ophavsret)","Tailwind CSS","Tailwind Labs, Inc.","MIT","React Email","Plus Five Five, Inc. (Resend)","Supabase JavaScript client","Supabase","ce-la-react","Google LLC","BSD-3-Clause","Media Chrome","Mux, Inc.","Zustand","Paul Henschel and contributors","React Three Fiber, drei","Poimandres (pmndrs)","three.js","three.js authors","GSAP","GreenSock","GreenSocks gratis standardlicens","React Router","React Training LLC, Remix Software Inc.","React, React DOM","Meta Platforms, Inc. and affiliates","Bibliotek","Lavet af","Licens","fonts","Skrifttyper",[106],"Siden henter ingen skrifttyper: den bruger dem, der allerede findes på din enhed. [[Tilføjer brandet skrifttyper, står hver skrifttype og dens licens her]]","art","Billeder, film og lyde",[110,111],"Billederne, filmene, figurerne og lydene er tegnet og animeret i programkode af StoryTime. Vi bruger ikke AI-værktøjer, der laver billeder eller video.","Der er endnu ingen indtalte stemmer. Når de kommer, krediteres hver stemme her. [[Stemmer og indspilningstjeneste]]","stories","Historier",[115,116],"Historier skrevet af StoryTime er mærket som StoryTimes.","En historie skrevet af en ekstern forfatter krediteres forfatteren og tilhører fortsat forfatteren; vi bruger den med tilladelse. [[Forfatterens navn, som hun ønsker det vist, og datoen for hendes skriftlige tilladelse]]",{"_1":118,"_119":120},"da","dict",{"_121":122,"_123":124,"_125":126,"_127":128,"_129":130,"_112":131,"_132":133},"common",{"_1118":1119,"_1120":1121,"_1122":1123,"_1124":716,"_1125":1126,"_21":1127,"_947":1128,"_1129":1130,"_1131":1132,"_311":1133,"_1134":1135},"actions",{"_1110":1111,"_1112":442,"_906":1113,"_1114":1115,"_1116":1117,"_244":245,"_291":292,"_293":294,"_382":383,"_833":834},"pages",{"_1068":1069,"_483":1070,"_1071":1072,"_1073":1074,"_1075":1076,"_1077":1078,"_1079":1080,"_759":1081,"_134":1082,"_136":1083},"account",{"_697":698,"_699":700,"_701":702,"_703":704,"_705":706,"_191":707},"commerce",{"