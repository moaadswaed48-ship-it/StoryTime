[{"_1":2,"_3":4},"lang",{"_5":105},"routes/legal",{"_5":6},"data",{"_7":8,"_9":10,"_11":12,"_13":14,"_15":16},"doc","cookies","title","Cookies og lokal lagring","summary","Hvad siden gemmer i din browser og hvorfor. Ingen sporingscookies, ingen reklamer, intet at acceptere.","sections",[37,38,39,40,41,42],"chrome",{"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36},"draftTitle","Udkast: endnu ikke gennemgået af en advokat","draftBody","Denne side er et arbejdsudkast. En advokat har ikke gennemgået den endnu, og den kan ændre sig, før StoryTime åbner for salg. Markerede steder er oplysninger, vi endnu ikke har udfyldt.","placeholder","Udfyldes senere:","placeholderKey","Sådan markeres en oplysning, der endnu mangler","updated","Udkast af {date}","version","Vilkårsversion {version}","languageNote","Disse sider findes på arabisk, hebraisk, engelsk og dansk. [[Hvilken sprogversion der gælder, hvis de afviger: afgøres med vores advokat]]","contents","På denne side","otherPages","Andre juridiske sider","backToTop","Til toppen af siden",{"_43":100,"_9":101,"_46":102},{"_43":61,"_9":62,"_46":63},{"_43":57,"_9":58,"_46":59},{"_43":53,"_9":54,"_46":55},{"_43":49,"_9":50,"_46":51},{"_43":44,"_9":45,"_46":47},"id","updates","Hvis det ændrer sig","body",[48],"Ønsker vi nogensinde at tilføje en valgfri cookie eller et måleværktøj, spørger vi dig først med et tydeligt valg og opdaterer denne side.","control","Du bestemmer",[52],"Du kan slette alt, hvad siden gemmer, ved at rydde sidens data i din browsers indstillinger. Derefter skal du logge ind igen, og indstillingerne går tilbage til standard.","others","Andre virksomheder",[56],"Ingen andre virksomheder sætter cookies gennem StoryTime. Når du betaler, kommer du til betalingsselskabets egen side, som har sine egne cookieregler. [[Betalingsselskabet og dets cookiepolitik]]","testMode","Mens siden er i testtilstand",[60],"Før salget åbner, kan siden køre i en testtilstand, og en besked på skærmen siger det. I testtilstand gemmes konti, profiler og fremskridt kun i denne browser (storytime.local…), ikke på en server.","what","Hvad der gemmes og hvorfor",[64,65],{"_66":67},"Disse elementer bliver på din enhed. Indstillingerne sendes ikke til os.","table",{"_68":69,"_70":71},"head",[97,98,99],"rows",[72,73,74,75,76,77,78],[94,95,96],[92,93,91],[89,90,91],[86,87,88],[84,85,81],[82,83,81],[79,80,81],"Små beskeder (storytime.access.dismissed, storytime.justDeleted)","Husker, at du lukkede en besked, eller at en konto lige er slettet","Til fanen lukkes","E-mail, der bekræftes (storytime.pendingEmail)","Viser din adresse på siden \"Tjek din e-mail\"","Voksentjek (storytime.gate.passedAt)","Husker i 10 minutter, at en voksen har svaret på tjekket","Sted i filmen (storytime.film…)","Hvor en film stoppede, så den kan fortsætte derfra","Til filmen slutter, eller du rydder lageret","Åben profil (storytime.activeLearner…)","Hvilken børneprofil der sidst var åben","Til du rydder browserens lager","Læse- og filmindstillinger (storytime.prefs…)","Tekststørrelse, undertekster, automatisk bladring, reol eller liste","Login (sb-…-auth-token)","Holder dig logget ind på denne enhed","Til du logger ud","Element","Hvad det gør","Hvor længe","short","Kort fortalt",[103,104],"StoryTime bruger ingen reklame-, analyse- eller sporingscookies. Siden gemmer nogle få små elementer i browserens eget lager, kun for at den kan virke: så du forbliver logget ind, og så dine indstillinger huskes. Derfor er der ikke noget cookiebanner at acceptere.","[[Om hostingtjenesten sætter en cookie, der er nødvendig for sikkerheden, når siden er i drift: bekræftes ved lanceringen]]",{"_1":106,"_107":108},"da","dict",{"_109":110,"_111":112,"_113":114,"_115":116,"_117":118,"_119":120,"_121":122},"common",{"_1057":1058,"_1059":1060,"_1061":1062,"_1063":669,"_1064":1065,"_21":1066,"_885":1067,"_272":1068,"_1069":1070},"actions",{"_1049":1050,"_1051":404,"_845":1052,"_1053":1054,"_1055":1056,"_202":203,"