[{"_1":2,"_3":4},"lang",{"_5":117},"routes/legal",{"_5":6},"data",{"_7":8,"_9":10,"_11":12,"_13":14,"_15":16},"doc","credits","title","Credits and licences","summary","Who wrote and made what you see on StoryTime, and the outside tools we use, with their licences.","sections",[37,38,39,40,41],"chrome",{"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36},"draftTitle","Draft: not yet reviewed by a lawyer","draftBody","This page is a working draft. A lawyer has not checked it yet, and it may change before StoryTime opens for sale. Marked gaps are details we have not filled in yet.","placeholder","To be filled in:","placeholderKey","Marked like this: a detail still to be filled in","updated","Draft of {date}","version","Terms version {version}","languageNote","These pages exist in Arabic, Hebrew, English and Danish. [[Which language version prevails if they differ: to be decided with our lawyer]]","contents","On this page","otherPages","Other legal pages","backToTop","Back to the top",{"_42":112,"_9":113,"_45":114},{"_42":107,"_9":108,"_45":109},{"_42":103,"_9":104,"_45":105},{"_42":48,"_9":49,"_45":50},{"_42":43,"_9":44,"_45":46},"id","copyright","Copyright","body",[47],"© 2026 [[business name]]. All rights reserved in StoryTime's stories, pictures, films and activities. A story credited to its author remains that author's.","code","Code libraries",[51,52,53],"StoryTime is built with these open libraries. We thank their makers.",{"_54":55},"These libraries use others in turn, each under its own licence. [[Full list of every library and its licence: to be generated before launch]]","table",{"_56":57,"_58":59},"head",[100,101,102],"rows",[60,61,62,63,64,65,66,67,68,69,70,71],[98,99,77],[96,97,77],[93,94,95],[91,92,77],[89,90,77],[87,88,77],[85,86,77],[82,83,84],[80,81,77],[78,79,77],[75,76,77],[72,73,74],"isbot","isbot contributors","Unlicense (public domain)","Tailwind CSS","Tailwind Labs, Inc.","MIT","React Email","Plus Five Five, Inc. (Resend)","Supabase JavaScript client","Supabase","ce-la-react","Google LLC","BSD-3-Clause","Media Chrome","Mux, Inc.","Zustand","Paul Henschel and contributors","React Three Fiber, drei","Poimandres (pmndrs)","three.js","three.js authors","GSAP","GreenSock","GreenSock standard no-charge licence","React Router","React Training LLC, Remix Software Inc.","React, React DOM","Meta Platforms, Inc. and affiliates","Library","Made by","Licence","fonts","Fonts",[106],"The site downloads no fonts: it uses the fonts already on your device. [[If the brand adds fonts, each font and its licence will be listed here]]","art","Pictures, films and sounds",[110,111],"The pictures, films, characters and sounds are drawn and animated in computer code by StoryTime. We do not use AI tools that make pictures or videos.","There are no recorded voices yet. When there are, each voice will be credited here. [[Voices and their recording service]]","stories","Stories",[115,116],"Stories written by StoryTime are labelled as StoryTime's.","A story written by an outside author is credited to that author and remains theirs; we use it with permission. [[Author's name as she wishes it shown, and the date of her written permission]]",{"_1":118,"_119":120},"en","dict",{"_121":122,"_123":124,"_125":126,"_127":128,"_129":130,"_112":131},"common",{"_1018":1019,"_1020":1021,"_1022":1023,"_1024":636,"_1025":1026,"_21":1027,"_853":1028,"_237":814,"_1029":1030},"actions",{"_1010":1011,"_1012":363,"_812":1013,"_1014":1015,"_1016":1017,"_167":168,"_214":215,"_216":217,"_302":303,"_737":738},"pages",{"_974":975,"_404":976,"_977":978,"_979":980,"_981":982,"_983":984,"_985":986,"_679":987},"account",{"_617":618,"_619":620,"_621":622,"_623":624,"_625":626,"_145":627},"commerce",{"_398":399,"_400":401,"_402":403,"_404":405,"_406":407,"_408":409,"_410":411},{"_132":133,"_21":134,"_135":136,"_137":138,"_139":140,"_141":142,"_143":144,"_145":146},"library",{"_349":350,"_351":352,"_353":354,"_355":356,"_357":160,"