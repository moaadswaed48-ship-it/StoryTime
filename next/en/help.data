[{"_1":2,"_3":4},"lang",{"_5":38},"routes/help",{"_5":6},"data",{"_7":8},"faq",[9,10,11,12,13,14,15,16,17],{"_18":36,"_20":37},{"_18":34,"_20":35},{"_18":32,"_20":33},{"_18":30,"_20":31},{"_18":28,"_20":29},{"_18":26,"_20":27},{"_18":24,"_20":25},{"_18":22,"_20":23},{"_18":19,"_20":21},"q","Is there a recorded voice?","a","Not yet. A narrator will record every story in each language, with separate recordings for the book and the film. The voice arrives before passes go on sale; until then, the books are for reading aloud yourself.","Which devices does it work on?","Phones, tablets and computers, in an up-to-date web browser. There is no app to install.","Can kindergarten teachers use it?","Yes. Choose “Kindergarten staff” when you sign up, and your profile becomes your class. Every activity has a version for a group of children.","What do you keep about my child?","Accounts belong to adults. A child’s profile holds only a first name or nickname and an age group. A teacher’s profile is a class name, with no children’s names. We never ask for a phone number, and there are no ads.","How do I cancel?","A pass ends on its end date, and nothing renews. Within 14 days of buying, a purchase can be cancelled in Settings, on the “Cancel a purchase” page, or by email or post. The refund comes within 14 days; a fee of at most 5% of the price or 100 shekels, whichever is lower, may apply.","What does the free trial include?","3 stories of the age group you choose, for 3 days, fully open. No card is needed, and the trial never turns into a payment.","Which languages are there?","Arabic, Hebrew, English and Danish, for the site, the stories and, once the films are ready, their captions. The language of the site and the language of the stories are set separately, so a child’s stories can be in one language while the grown-up uses the site in another.","How much screen time is this?","The activity happens away from the screen, and the book is made to be read together. The films, once they are ready, will be short and stop at the end; nothing will start playing by itself. The World Health Organization advises no more than one hour of screen time a day for children aged 2 to 4, and less is better.","Which age group fits my child?","Choose by age: 2–3, 4–5 or 6–8. A three-year-old stays in the first group until the fourth birthday. One account can hold passes for two age groups, for families with children of different ages.",{"_1":39,"_40":41},"en","dict",{"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":55},"common",{"_1041":1042,"_1043":1044,"_1045":1046,"_1047":636,"_1048":1049,"_102":1050,"_867":1051,"_1052":1053,"_1054":1055,"_236":828,"_1056":1057},"actions",{"_1033":1034,"_1035":361,"_826":1036,"_1037":1038,"_1039":1040,"_168":169,"_216":217,"_218":219,"_301":302,"_753":754},"pages",{"_988":989,"_402":990,"_991":992,"_993":994,"_995":996,"_997":998,"_999":1000,"_679":1001,"_56":1002,"_58":1003},"account",{"_617":618,"_619":620,"_621":622,"_623":624,"_625":626,"_114":627},"commerce",{"_396":397,"_398":399,"_400":401,"_402":403,"_404":405,"_406":407,"_408":409},"stories",{"_100":101,"_102":103,"_104":105,"_106":107,"_108":109,"_110":111,"_112":113,"_114":115,"_116":117},"support",{"_56":57,"_58":59},"help",{"_60":86,"_87":85,"_88":89,"_90":91,"_92":93,"_94":95,"_96":97,"_98":99},"contact",{"_60":61,"_62":63,"_64":65,"_66":67,"_68":69,"_70":71,"_72":73,"_74":75,"_76":77,"_78":79,"_80":81,"_82":83,"_84":85},"lead","A question, an idea or a problem with the site: write it here.","name","Name","email","Email address","emailHint","Used only to answer this message.","message","Message","messageHint","Up to 2,000 characters.","tooLong","The message is too long. Keep it to 2,000 characters.","send","Send the message","sent","Thank you. Your message is saved.","sendAnother","Write another message","testNote","Test mode: messages are kept only in this browser. Nobody reads them yet, and no email is sent.","otherWays","Other ways to reach us","helpLink","Questions and answers","Answers to the questions parents and kindergarten staff ask most, and how to reach us.","faqTitle","contactTitle","Still have a question?","contactLead","Write to us through the contact form.","contactLink","Open the contact form","emailPlaceholder","Support email address: to be added before sales open.","cancelTitle","Cancelling a purchase","cancelLead","Within 14 days of buying a pass, the purchase can be cancelled on the “Cancel a purchase” page.","library",{"_347":348,"_349":350,"_351":352,"_353":354,"_355":161,"_356":357,"_358":359,"_360":361,"_362":363,"_364":365,"_366":367,"_368":369,"_370":371,"_372":373,"_374":375,"_376":377,"_378":379,"_380":381,"_382":383,"_384":385,"_386":387,"_388":389,"_390":391,"_392":393,"_394":395},"placeholder",{"_343":344,"_345":346},"doors",{"_160":300,"_301":302,"_303":304,"_270":271,"_305":306,"_307":308,"_309":310,"_311":312,"_313":314,"_298":315,"_316":317,"_318":319,"_320":321,"_322":323,"_324":325,"_326":327,"_328":329,"_330":331,"_332":333,"_145":334,"_335":336,"_337":338,"_339":340,"_341":342},"reader",{"_255":256,"_168":257,"_258":259,"_260":261,"_262":263,"_264":265,"_266":267,"_268":269,"_270":271,"_218":219,"_149":272,"_273":274,"_275":276,"_277":278,"_279":280,"_281":282,"_283":284,"_236":285,"_286":287,"_288":289,"_290":291,"_292":293,"_294":295,"_296":297,"_298":299},"film",{"_174":206,"_168":207,"_208":209,"_210":211,"_212":213,"_214":215},"activity",{"_174":175,"_176":177,"_178":179,"_180":181,"_182":183,"_184":185,"_186":187,"_188":189,"_190":191,"_192":193,"_194":195,"_196":197,"_198":199,"_200":201,"_202":203,"_204":205},"collections",{"_52":155,"_156":157,"_158":159,"_160":161,"_162":163,"_164":165,"_166":167,"_168":169,"_170":171,"_172":173},"settings",{"_147":148,"_149":150,"_151":152,"_153":154},"classroom",{"_118":119,"_120":121,"_122":123,"_124":125,"_126":127,"_128":119,"_129":130,"_131":132,"_133":134,"_135":136,"_137":138,"_139":140,"_141":142,"_143":144,"_145":14